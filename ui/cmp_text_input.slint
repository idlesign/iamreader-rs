import { VerticalBox, LineEdit, TextEdit } from "std-widgets.slint";

export component TextInputField inherits VerticalBox {
    in property <string> label: "";
    in-out property <string> text: "";
    in property <int> field-height: 32;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <string> error-message: "";
    in property <string> help-text: "";

    padding: 0px;
    spacing: 4px;
    min-width: 0px;
    vertical-stretch: 0;
    alignment: start;

    if root.label != "": Text {
        text: root.label;
        font-size: 12px;
        color: #334155;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    LineEdit {
        text <=> root.text;
        enabled: root.enabled;
        read-only: root.read-only;
        font-size: 14px;
        min-width: 0px;
        height: max(32px, root.field-height * 1px);
    }
    if root.error-message != "" || root.help-text != "": Text {
        text: root.error-message != "" ? root.error-message : root.help-text;
        color: root.error-message != "" ? #b91c1c : #64748b;
        font-size: 11px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
}

export component TextInputFieldMultiline inherits VerticalBox {
    in property <string> label: "";
    in-out property <string> text: "";
    in property <int> field-height: 96;
