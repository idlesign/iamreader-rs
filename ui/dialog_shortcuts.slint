import { VerticalBox, HorizontalBox, ScrollView, Button } from "std-widgets.slint";
import { DialogHeader, DialogSeparator } from "cmp_dialog_header.slint";

export component ShortcutsDialog inherits Rectangle {
    width: 520px;
    height: 480px;
    background: #ffffff;
    border-width: 1px;
    border-color: #94a3b8;
    border-radius: 6px;
    in property <string> shortcuts-list-text: "";
    callback cancel();

    TouchArea { clicked => { } }
    VerticalBox {
        padding: 12px;
        spacing: 8px;
        min-width: 0px;
        DialogHeader {
            title: "Keyboard shortcuts";
            cancel => { root.cancel(); }
        }
        DialogSeparator {}
        ScrollView {
            min-height: 0px;
            min-width: 0px;
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            VerticalBox {
                padding: 4px;
                min-width: 0px;
                alignment: start;
                Text {
                    text: root.shortcuts-list-text;
                    wrap: word-wrap;
                    color: #334155;
                    font-size: 14px;
                }
            }
        }
        HorizontalBox {
            padding: 0px;
            height: 32px;
            alignment: end;
            Button {
                text: "Close";
                width: 88px;
                clicked => { root.cancel(); }
            }
        }
    }
}
