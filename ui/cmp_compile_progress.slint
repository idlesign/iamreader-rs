import { VerticalBox, HorizontalBox, ScrollView, Button } from "std-widgets.slint";

export component CompileProgressDialog inherits Rectangle {
    in property <float> progress: 0.0;
    in property <string> stage: "";
    in property <string> stages-text: "";
    /// Оставшееся время в секундах; < 0 — не показывать
    in property <float> eta-secs: -1.0;
    /// Cancel доступен только до запроса отмены и до начала публикации результата.
    in property <bool> cancel-enabled: true;
    in property <bool> finished: false;
    in property <bool> cancel-requested: false;
    in property <bool> publishing: false;
    callback cancel();
    callback close();

    width: 480px;
    height: 320px;
    background: #ffffff;
    border-width: 2px;
    border-color: #333;

    changed finished => {
        // Итог всегда виден первым, даже если пользователь прокручивал журнал стадий.
        if root.finished {
            status-scroll.viewport-y = 0px;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { }
    }
    VerticalBox {
        height: 100%;
        padding: 20px;
        spacing: 8px;

        Text {
            text: "Export";
            font-size: 16px;
            font-weight: 700;
        }

        status-scroll := ScrollView {
            preferred-height: 100%;
            min-height: 0px;
            viewport-width: self.visible-width;
            VerticalBox {
                padding: 0px;
                spacing: 8px;
                Text {
                    // Текущая стадия/итог не подменяется непустым журналом стадий.
                    text: root.finished ? (root.stage != "" ? root.stage : "Export finished")
                        : root.publishing ? "Publishing result…"
                        : root.cancel-requested ? "Cancelling…"
                        : root.stage != "" ? root.stage : "Preparing export…";
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                    color: #333;
                }
                Text {
                    text: root.stages-text;
                    font-size: 13px;
                    wrap: word-wrap;
                    color: #666;
                }
            }
        }

        if !root.finished: Rectangle {
            height: 20px;
            border-width: 1px;
            border-color: #999;
            background: #f5f5f5;
            Rectangle {
                x: 0px;
                width: min(1, max(0, root.progress)) * parent.width;
                height: 100%;
                background: #4CAF50;
            }
        }

        if !root.finished: HorizontalBox {
            alignment: center;
            spacing: 16px;
            Text {
                text: "Overall ~" + Math.round(min(1, max(0, root.progress)) * 100) + "%";
                font-size: 14px;
            }
            Text {
                text: !root.cancel-requested && !root.publishing && root.eta-secs >= 0
                    ? "Stage ETA " + format-eta(root.eta-secs) : "";
                font-size: 12px;
                color: #666;
            }
        }

        // Действие вне ScrollView: Cancel/Close остаётся доступным при длинном журнале.
        Button {
            text: root.finished ? "Close" : root.publishing ? "Publishing…"
                : root.cancel-requested ? "Cancelling…" : "Cancel";
            enabled: root.finished || root.cancel-enabled;
            clicked => {
                if root.finished {
                    root.close();
                } else {
                    root.cancel();
                }
            }
        }
    }
    function pad2(v: int) -> string {
        return v < 10 ? "0" + v : "" + v;
    }
    function format-eta(secs: float) -> string {
        if (secs < 0) { return "—"; }
        let s = Math.round(secs);
        let h = Math.floor(s / 3600);
        let m = Math.floor(Math.mod(s, 3600) / 60);
        let sec = Math.mod(s, 60);
        return pad2(h) + ":" + pad2(m) + ":" + pad2(sec);
    }
}
