import { VerticalBox, HorizontalBox, Button, ScrollView } from "std-widgets.slint";
import { DialogHeader, DialogSeparator } from "cmp_dialog_header.slint";

export component DeleteChunkDialog inherits Rectangle {
    width: 440px;
    height: 180px;
    background: #ffffff;
    border-width: 1px;
    border-color: #94a3b8;
    border-radius: 6px;

    in property <string> message: "";

    callback confirm();
    callback cancel();

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { }
    }
    VerticalBox {
        height: 100%;
        padding: 12px;
        spacing: 8px;

        DialogHeader {
            title: "Delete recording?";
            cancel => {
                root.cancel();
            }
        }

        DialogSeparator {}

        ScrollView {
            min-height: 0px;
            viewport-width: self.visible-width;
            vertical-stretch: 1;
            VerticalBox {
                padding-top: 12px;
                padding-bottom: 12px;
                Text {
                    text: root.message;
                    wrap: word-wrap;
                }
            }
        }

        HorizontalBox {
            padding: 0px;
            height: 32px;
            alignment: end;
            spacing: 10px;

            Button {
                text: "Cancel";
                width: 80px;
                primary: false;
                clicked => {
                    root.cancel();
                }
            }
            Button {
                text: "Delete";
                width: 88px;
                primary: true;
                clicked => {
                    root.confirm();
                }
            }
        }
    }
}
