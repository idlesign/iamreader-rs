import { VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";
import { StatusIndicators } from "cmp_status_indicators.slint";

export struct FileInfo {
    index: int,
    name: string,
    path: string,
    markers: string,
    duration: string,
    start-time: string,
    size: string,
    is-recording: bool,
    is-playing: bool,
    title: string,
    author: string,
    year: string,
    hint: string,
}

// На узком окне сначала сохраняем читаемость времени, имени и размера.
// На широком — прежние пропорции; title получает оставшуюся ширину.
component FileColumns inherits Rectangle {
    out property <length> markers-width: max(60px, self.width * 10 / 88);
    out property <length> duration-width: max(64px, self.width * 10 / 88);
    out property <length> start-time-width: max(64px, self.width * 10 / 88);
    out property <length> name-width: max(96px, self.width * 14 / 88);
    out property <length> size-width: max(72px, self.width * 6 / 88);
    out property <length> title-width: max(0px, self.width - self.markers-width
        - self.duration-width - self.start-time-width - self.name-width - self.size-width);
    out property <length> duration-x: self.title-width + self.markers-width;
    out property <length> start-time-x: self.duration-x + self.duration-width;
    out property <length> name-x: self.start-time-x + self.start-time-width;
    out property <length> size-x: self.name-x + self.name-width;

    horizontal-stretch: 1;
    min-width: 0px;
    clip: true;
    @children
}

export component FileList inherits Rectangle {
    in property <bool> enabled: true;
    in property <[FileInfo]> files: [];
    in-out property <int> current-index: -1;
    in-out property <length> scroll-viewport-y: 0px;
    out property <length> visible-height: listview.visible-height;
    in property <string> total-files: "";
    in property <string> total-duration: "";
    in property <string> total-size: "";
    in property <bool> is-recording: false;

    callback file-clicked(int);
    callback file-double-clicked(int);
    callback dialog-chunk-request-open(int);

    private property <bool> recording-blink: false;

    background: #f5f5f5;
    border-width: 1px;
    border-color: #ccc;

    Timer {
        interval: 500ms;
        running: root.is-recording;
        triggered => {
            root.recording-blink = !root.recording-blink;
        }
    }

    VerticalBox {
        listview := ListView {
            enabled: root.enabled;
            preferred-height: 100%;
            viewport-y <=> root.scroll-viewport-y;
            for file[index] in files: Rectangle {
                width: parent.width;
                height: 30px;
                background: current-index == index ? #d0e8ff : #f5f5f5;
                border-width: 1px;
                border-color: #ccc;

                TouchArea {
                    enabled: root.enabled;
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.file-clicked(index);
                    }
                    double-clicked => {
                        root.file-double-clicked(index);
                    }
                }

                HorizontalBox {
                    padding-left: 10px;
                    padding-right: 10px;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    // Индекс — фиксированная ширина
                    Rectangle {
                        preferred-width: 50px;
                        min-width: 50px;
                        clip: true;
                        Text {
                            text: file.index + ".";
                            color: #333;
                            font-family: "Ubuntu Mono";
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }
                    }
                    columns := FileColumns {
                        Rectangle {
                            x: 0;
                            width: columns.title-width;
                            height: parent.height;
                            clip: true;
                            Text {
                                text: file.title;
                                width: max(0px, parent.width - 4px);
                                color: #333;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            x: columns.title-width;
                            width: columns.markers-width;
                            height: parent.height;
                            clip: true;
                            Text {
                                text: file.markers;
                                x: 4px;
                                width: parent.width - 8px;
                                color: #666;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            x: columns.duration-x;
                            width: columns.duration-width;
                            height: parent.height;
                            clip: true;
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                text: file.duration;
                                color: #333;
                                font-family: "Ubuntu Mono";
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                // Числа не сокращаем: для них зарезервирована минимальная ширина.
                                overflow: clip;
                            }
                        }
                        Rectangle {
                            x: columns.start-time-x;
                            width: columns.start-time-width;
                            height: parent.height;
                            clip: true;
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                text: file.start-time;
                                color: #333;
                                font-family: "Ubuntu Mono";
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: clip;
                            }
                        }
                        Rectangle {
                            x: columns.name-x;
                            width: columns.name-width;
                            height: parent.height;
                            clip: true;
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                text: file.name;
                                color: #333;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                        }
                        Rectangle {
                            x: columns.size-x;
                            width: columns.size-width;
                            height: parent.height;
                            clip: true;
                            Text {
                                x: 4px;
                                width: parent.width - 8px;
                                text: file.size;
                                color: #333;
                                font-family: "Ubuntu Mono";
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                overflow: clip;
                            }
                        }
                    }
                    // Индикаторы — фиксированная ширина, всегда в видимой области
                    StatusIndicators {
                        is-recording: file.is-recording;
                        is-playing: file.is-playing;
                    }
                }
            }
        }
        // Суммирующая строка - всегда видна
        Rectangle {
            height: 30px;
            background: #e8e8e8;
            border-width: 1px;
            border-color: #aaa;

            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                horizontal-stretch: 1;
                Rectangle {
                    preferred-width: 50px;
                    min-width: 50px;
                    clip: true;
                    Text {
                        text: total-files;
                        color: #333;
                        font-family: "Ubuntu Mono";
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }
                summary-columns := FileColumns {
                    Rectangle {
                        x: summary-columns.duration-x;
                        width: summary-columns.duration-width;
                        height: parent.height;
                        clip: true;
                        Text {
                            x: 4px;
                            width: parent.width - 8px;
                            text: total-duration;
                            color: #333;
                            font-family: "Ubuntu Mono";
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: clip;
                        }
                    }
                    Rectangle {
                        x: summary-columns.name-x;
                        width: summary-columns.name-width + summary-columns.size-width;
                        height: parent.height;
                        clip: true;
                        Text {
                            x: 4px;
                            width: parent.width - 8px;
                            text: total-size;
                            color: #333;
                            font-family: "Ubuntu Mono";
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: clip;
                        }
                    }
                }
                Rectangle {
                    preferred-width: 24px;
                    min-width: 24px;
                    max-width: 24px;
                }
            }
        }
    }
}
